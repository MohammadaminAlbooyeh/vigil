# Sentinel-X Environment Configuration
# Copy to .env and adjust for your deployment. All variables use the SENTINEL_ prefix.

# App
SENTINEL_APP_NAME=Sentinel-X
SENTINEL_VERSION=1.0.0
SENTINEL_DEBUG=false

# API
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000

# Database (PostgreSQL)
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel123@localhost:5432/sentinel-x

# Redis
SENTINEL_REDIS_URL=redis://localhost:6379/0

# MQTT Broker
SENTINEL_MQTT_BROKER=192.168.1.100
SENTINEL_MQTT_PORT=1883
SENTINEL_MQTT_USER=sentinel
SENTINEL_MQTT_PASS=sentinel123

# Security
SENTINEL_SECRET_KEY=change-this-in-production-to-a-long-random-string
SENTINEL_JWT_ALGORITHM=HS256
SENTINEL_JWT_EXPIRE_MINUTES=60

# mTLS (optional)
SENTINEL_MTLS_CERT_PATH=
SENTINEL_MTLS_KEY_PATH=
SENTINEL_MTLS_CA_PATH=

# External services
SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=

# MinIO object storage
SENTINEL_MINIO_ENDPOINT=localhost:9000
SENTINEL_MINIO_ACCESS_KEY=sentinel
SENTINEL_MINIO_SECRET_KEY=sentinel123
SENTINEL_MINIO_BUCKET=sentinel-x-media

# Rules
SENTINEL_RULES_CONFIG_PATH=config/rules.yaml
